[Unit]
Description=Cloudflare Tunnel Daemon
After=network-online.target
Wants=network-online.target

[Service]
TimeoutStartSec=0
Type=notify
ExecStart=/usr/bin/cloudflared --config /etc/cloudflared/config.yml --protocol http2 tunnel run
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target